# LearnOrbit Environment Variables
# Copy this file to .env and fill in your values

# Flask settings
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database (leave as SQLite for local dev, use PostgreSQL URL for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/learnorbit

# Export directory for PDF notes
# EXPORT_DIR=/tmp/learnorbit_exports
