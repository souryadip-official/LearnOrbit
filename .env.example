# LearnOrbit Environment Variables
# Copy this file to .env and fill in your values

# Flask settings
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database (leave as SQLite for local dev, use PostgreSQL URL for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/learnorbit

# Export directory for PDF notes
# EXPORT_DIR=/tmp/learnorbit_exports

# Optional staff tools. Staff identities and password hashes live in the
# owner-only, gitignored instance/admins.json file; do not put passwords here.
# Production admin login requires Twilio SMS credentials. Development prints
# the one-time code to the server terminal only.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# ADMIN_OTP_COUNTRY_CODE=+91

# Optional provider for staff-requested, private feedback-comment synthesis.
# Comment text is sent to the selected provider only after an admin requests it.
# GEMINI_API_KEY=
# GEMINI_FEEDBACK_MODEL=gemini-3.1-flash-lite
# HF_TOKEN=
# HF_FEEDBACK_MODEL=openai/gpt-oss-120b
